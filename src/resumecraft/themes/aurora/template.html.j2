<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ resume.full_name }} — {{ resume.title }}</title>
<style>{{ inline_css }}</style>
</head>
<body>
{% set _parts = resume.full_name.split(' ') %}
{% set _initials = (_parts[0][0] ~ (_parts[-1][0] if _parts|length > 1 else '')) | upper %}
<table class="page" cellspacing="0" cellpadding="0">
<tr>
  <td class="sidebar">
    <div class="avatar-badge">{{ _initials }}</div>
    <h1>{{ resume.full_name }}</h1>
    <div class="headline">{{ resume.title }}</div>

    <div class="side-block">
      <h2>{{ labels.contacts }}</h2>
      <ul class="side-list">
        {% if resume.location %}<li>{{ resume.location }}</li>{% endif %}
        {% if resume.phone %}<li>{{ resume.phone }}</li>{% endif %}
        {% if resume.email %}<li><a href="mailto:{{ resume.email }}">{{ resume.email }}</a></li>{% endif %}
        {% if resume.linkedin %}<li><a href="{{ resume.linkedin }}">LinkedIn</a></li>{% endif %}
        {% if resume.github %}<li><a href="{{ resume.github }}">GitHub</a></li>{% endif %}
        {% if resume.website %}<li><a href="{{ resume.website }}">{{ resume.website }}</a></li>{% endif %}
        {% if resume.salary %}<li>{{ resume.salary }}</li>{% endif %}
      </ul>
    </div>

    {% if resume.skills %}
    <div class="side-block">
      <h2>{{ labels.skills }}</h2>
      {% for cat in resume.skills %}
        <div class="skill-group">
          <div class="skill-cat">{{ cat.category }}</div>
          <div class="pill-row">
            {% for item in cat.items %}<span class="pill">{{ item }}</span>{% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if resume.languages %}
    <div class="side-block">
      <h2>{{ labels.languages }}</h2>
      <ul class="side-list">
        {% for l in resume.languages %}<li>{{ l.language }}{% if l.level %} <span class="muted">— {{ l.level }}</span>{% endif %}</li>{% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if resume.certifications %}
    <div class="side-block">
      <h2>{{ labels.certifications }}</h2>
      <ul class="side-list">
        {% for c in resume.certifications %}<li>{{ c }}</li>{% endfor %}
      </ul>
    </div>
    {% endif %}
  </td>

  <td class="main">
    {% if resume.summary %}
    <section class="section">
      <h2>{{ labels.summary }}</h2>
      <p>{{ resume.summary }}</p>
    </section>
    {% endif %}

    {% if resume.experience %}
    <section class="section">
      <h2>{{ labels.experience }}</h2>
      {% for exp in resume.experience %}
        <div class="card">
          <div class="card-row">
            <span class="card-title">{{ exp.position }}</span>
            <span class="card-date">{{ exp.duration_text(present_label) }}</span>
          </div>
          <div class="card-sub">{{ exp.company }}{% if exp.location %} · {{ exp.location }}{% endif %}</div>
          <ul>
            {% for line in exp.description %}<li>{{ line }}</li>{% endfor %}
          </ul>
        </div>
      {% endfor %}
    </section>
    {% endif %}

    {% if resume.education %}
    <section class="section">
      <h2>{{ labels.education }}</h2>
      {% for edu in resume.education %}
        <div class="card">
          <div class="card-row">
            <span class="card-title">{{ edu.degree }}{% if edu.field %}, {{ edu.field }}{% endif %}</span>
            <span class="card-date">{{ edu.duration_text(present_label) }}</span>
          </div>
          <div class="card-sub">{{ edu.institution }}{% if edu.location %} · {{ edu.location }}{% endif %}{% if edu.gpa %} · GPA {{ edu.gpa }}{% endif %}</div>
        </div>
      {% endfor %}
    </section>
    {% endif %}

    {% if resume.projects %}
    <section class="section">
      <h2>{{ labels.projects }}</h2>
      {% for proj in resume.projects %}
        <div class="card">
          <div class="card-row">
            <span class="card-title">
              {% if proj.url %}<a href="{{ proj.url }}">{{ proj.name }}</a>{% else %}{{ proj.name }}{% endif %}
            </span>
          </div>
          {% if proj.description %}<p class="card-desc">{{ proj.description }}</p>{% endif %}
          {% if proj.technologies %}
            <div class="pill-row">
              {% for t in proj.technologies %}<span class="pill pill-accent">{{ t }}</span>{% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </section>
    {% endif %}

    {% if resume.additional %}
    <section class="section">
      <h2>{{ labels.additional }}</h2>
      <p>{{ resume.additional }}</p>
    </section>
    {% endif %}
  </td>
</tr>
</table>
</body>
</html>
